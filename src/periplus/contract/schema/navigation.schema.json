{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://periplus.dev/schema/0/navigation.schema.json",
  "title": "Periplus navigation result",
  "description": "What `--format json` prints for the navigation commands: types, legend, find, show, neighbors, affected, depth, only, hubs, members, pieces, count, path and slice, and what `export --report json` prints to standard error. Each command has one definition under $defs, show two (show_many for several ids), slice two (slice with --out, slice_piece without), and the root accepts any of them. A command that returns a list wraps it in the shared listing: items, total (every item there was), shown (how many items are here) and truncated (true when --limit cut the list). Output is deterministic: keys sorted, ASCII only.",

  "anyOf": [
    {"$ref": "#/$defs/types"},
    {"$ref": "#/$defs/legend"},
    {"$ref": "#/$defs/find"},
    {"$ref": "#/$defs/show"},
    {"$ref": "#/$defs/neighbors"},
    {"$ref": "#/$defs/affected"},
    {"$ref": "#/$defs/depth"},
    {"$ref": "#/$defs/show_many"},
    {"$ref": "#/$defs/only"},
    {"$ref": "#/$defs/hubs"},
    {"$ref": "#/$defs/members"},
    {"$ref": "#/$defs/pieces"},
    {"$ref": "#/$defs/count"},
    {"$ref": "#/$defs/in"},
    {"$ref": "#/$defs/at"},
    {"$ref": "#/$defs/files"},
    {"$ref": "#/$defs/undescribed"},
    {"$ref": "#/$defs/stamp"},
    {"$ref": "#/$defs/stale"},
    {"$ref": "#/$defs/order"},
    {"$ref": "#/$defs/path"},
    {"$ref": "#/$defs/slice"},
    {"$ref": "#/$defs/slice_piece"},
    {"$ref": "#/$defs/export"}
  ],

  "$defs": {

    "problem": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "detail"],
      "properties": {
        "code": {"type": "integer"},
        "message": {"type": "string"},
        "detail": {"type": "object"}
      }
    },
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "place": {"description": "Where a row's edge is written as file:line, else the node it reaches, or null when neither has a location.", "type": ["string", "null"]},
    "source": {"description": "The stripped source line at the row's place, at most 160 characters, or null when the file or line cannot be read.", "type": ["string", "null"]},
    "marks": {"description": "The mark text of each attribute the node holds that the map's marks header names, in attribute-name order, as the text prints each in brackets; empty when none.", "type": "array", "items": {"type": "string"}},
    "node_text": {"description": "The descriptions.yaml text of the row's node, or null when it has none.", "type": ["string", "null"]},

    "location": {
      "type": "object", "required": ["file", "line"],
      "properties": {"file": {"type": "string"}, "line": {"type": "integer"}}
    },
    "provenance": {
      "type": "object", "required": ["pack", "rule"],
      "properties": {
        "pack": {"type": "string"},
        "rule": {"type": "string"},
        "confidence": {"enum": ["declared", "inferred", "mentioned"]},
        "sets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "description": {
      "description": "The descriptions.yaml entry for a node or edge, or null when it has none.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["text", "file", "line"],
          "properties": {"text": {"type": "string"}, "file": {"type": "string"}, "line": {"type": "integer"}}
        },
        {"type": "null"}
      ]
    },

    "listing": {
      "description": "The shared cut list. The items schema is supplied by the command that uses it.",
      "type": "object", "additionalProperties": false, "required": ["items", "total", "shown", "truncated"],
      "properties": {
        "items": {"type": "array"},
        "total": {"type": "integer", "minimum": 0},
        "shown": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },

    "types": {
      "type": "object", "additionalProperties": false, "required": ["node_types", "edge_kinds", "problems"],
      "properties": {
        "node_types": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "count", "parent"],
            "properties": {
              "type": {"type": "string"},
              "count": {"type": "integer", "minimum": 0},
              "parent": {"type": ["string", "null"]}
            }
          }
        },
        "edge_kinds": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "count"],
            "properties": {"kind": {"type": "string"}, "count": {"type": "integer", "minimum": 0}}
          }
        },
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "legend": {
      "description": "The edge kinds and node types the map holds, most frequent first, each with the pack's one-line description from the map's legend, or null.",
      "type": "object", "additionalProperties": false, "required": ["edge_kinds", "node_types", "left_out", "warnings", "problems"],
      "properties": {
        "edge_kinds": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "count", "from", "to", "description", "cause"],
            "properties": {
              "kind": {"type": "string"},
              "count": {"type": "integer", "minimum": 1},
              "from": {"description": "The types at the edges' from ends, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "to": {"description": "The types at the edges' to ends, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "description": {"type": ["string", "null"]},
              "cause": {"description": "Which end sets off the other, from the map's cause lists; null when the map lists the kind under none.", "enum": ["from", "to", "none", "touch", null]}
            }
          }
        },
        "node_types": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "count", "parent", "description", "out", "in"],
            "properties": {
              "type": {"type": "string"},
              "count": {"type": "integer", "minimum": 1},
              "parent": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "out": {"description": "The kinds of the edges leaving nodes of this type, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "in": {"description": "The kinds of the edges reaching nodes of this type, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "left_out": {"description": "How many rows the default text's byte budget left out, the least frequent first; 0 with --all, --kind or --type.", "type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "find": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "total", "shown", "truncated", "by_type", "warnings", "problems"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "state", "location", "source", "matched", "matched_attribute", "description", "supporting", "marks"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "state": {"type": "string"},
              "location": {"type": ["string", "null"]},
              "source": {"$ref": "#/$defs/source"},
              "matched": {"description": "id when the node id holds the text, attribute when a string attribute value or list item does, description when only its description does.", "enum": ["id", "attribute", "description"]},
              "supporting": {"description": "true when the node is in supporting code, by the map's supporting_paths.", "type": "boolean"},
              "marks": {"$ref": "#/$defs/marks"},
              "matched_attribute": {"description": "The name of the attribute that matched, the first in sorted order when several do; null unless matched is attribute.", "type": ["string", "null"]},
              "description": {"$ref": "#/$defs/node_text"}
            }
          }
        },
        "by_type": {
          "description": "Every match, not only the rows shown, counted by node type.",
          "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "total": {"type": "integer", "minimum": 0},
        "shown": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "edge_row": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "other", "other_type", "other_state", "other_marks", "locations", "occurrences", "confidences", "rules", "description", "location", "source", "supporting"],
      "properties": {
        "kind": {"type": "string"},
        "other": {"type": "string"},
        "supporting": {"description": "true when the other end is in supporting code, by the map's supporting_paths; such rows come after the rest.", "type": "boolean"},
        "other_type": {"type": "string"},
        "other_state": {"type": "string"},
        "other_marks": {"$ref": "#/$defs/marks"},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "occurrences": {"type": ["integer", "null"]},
        "confidences": {"type": "array", "items": {"enum": ["declared", "inferred", "mentioned"]}},
        "rules": {"type": "array", "items": {"type": "string"}},
        "description": {"$ref": "#/$defs/description"},
        "location": {"$ref": "#/$defs/place"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "edge_listing": {
      "allOf": [{"$ref": "#/$defs/listing"}],
      "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/edge_row"}}}
    },

    "show": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "state", "marks", "roles", "attributes", "locations", "provenance", "description", "outgoing", "incoming", "realized_by", "warnings", "problems"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "marks": {"$ref": "#/$defs/marks"},
        "roles": {"type": "array", "items": {"type": "string"}},
        "attributes": {"type": "object"},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
        "description": {"$ref": "#/$defs/description"},
        "outgoing": {"$ref": "#/$defs/edge_listing"},
        "incoming": {"$ref": "#/$defs/edge_listing"},
        "realized_by": {
          "description": "The mapped nodes that stand for this node across realizing edges, breadth first, at most 8, and how many more.",
          "type": "object", "additionalProperties": false, "required": ["items", "more"],
          "properties": {
            "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "kind", "stands_for"], "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "kind": {"type": "string"}, "stands_for": {"description": "The node this one stands for: the shown node, or a node that stands for it.", "type": "string"}}}},
            "more": {"type": "integer", "minimum": 0}
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "walk": {
      "type": "object", "additionalProperties": false, "required": ["start", "direction", "rows", "warnings", "problems"],
      "properties": {
        "start": {"type": "string"},
        "direction": {"enum": ["out", "in"]},
        "rows": {
          "allOf": [{"$ref": "#/$defs/listing"}],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "type", "state", "depth", "kind", "via", "location", "source", "description", "stands_for", "supporting", "marks"],
                "properties": {
                  "id": {"type": "string"},
                  "type": {"type": "string"},
                  "state": {"type": "string"},
                  "depth": {"description": "Hops from the start; 0 for a node that stands for the start.", "type": "integer", "minimum": 0},
                  "kind": {"type": "string"},
                  "via": {"type": "string"},
                  "supporting": {"description": "true when the item is in supporting code, by the map's supporting_paths; such rows come after the rest.", "type": "boolean"},
                  "marks": {"$ref": "#/$defs/marks"},
                  "stands_for": {"description": "true when the item was added because it stands for via across a realizing edge, at via's depth: a form of a declaration, or in affected the declaration of a form.", "type": "boolean"},
                  "location": {"$ref": "#/$defs/place"},
                  "source": {"$ref": "#/$defs/source"},
                  "description": {"$ref": "#/$defs/node_text"}
                }
              }
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },
    "neighbors": {
      "description": "A walk by cause (direction off), or the raw walk (direction out) with --raw or on a map with no cause lists.",
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/walk"}], "properties": {"direction": {"const": "out"}}},
        {"allOf": [{"$ref": "#/$defs/cause_walk"}], "properties": {"direction": {"const": "off"}}}
      ]
    },
    "affected": {
      "description": "A walk by cause (direction by), or the raw walk (direction in) with --raw or on a map with no cause lists.",
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/walk"}], "properties": {"direction": {"const": "in"}}},
        {"allOf": [{"$ref": "#/$defs/cause_walk"}], "properties": {"direction": {"const": "by"}}}
      ]
    },

    "hub": {
      "type": "object", "additionalProperties": false, "required": ["id", "hop", "fan"],
      "properties": {
        "id": {"type": "string"},
        "hop": {"type": "integer", "minimum": 1},
        "fan": {"description": "How many edges the walk would have followed from it, over the hub limit.", "type": "integer", "minimum": 1}
      }
    },
    "cause_row": {
      "type": "object", "additionalProperties": false,
      "required": ["hop", "id", "type", "state", "via_kind", "via_direction", "from", "file", "line", "marks", "supporting", "hub", "touch"],
      "properties": {
        "hop": {"description": "Hops from the starts; a touching row is one hop past the row it hangs from.", "type": "integer", "minimum": 1},
        "id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "via_kind": {"description": "The kind of the edge that reached it.", "type": "string"},
        "via_direction": {"description": "forward when that edge was followed from its from end, backward from its to end.", "enum": ["forward", "backward"]},
        "from": {"description": "The node it was reached from.", "type": "string"},
        "file": {"description": "Where that edge is written, else the node's first location; null when neither has one.", "type": ["string", "null"]},
        "line": {"type": ["integer", "null"]},
        "marks": {"$ref": "#/$defs/marks"},
        "supporting": {"description": "true when the node is in supporting code, by the map's supporting_paths.", "type": "boolean"},
        "hub": {"description": "The fan of a node the walk listed and did not walk from, or null.", "type": ["integer", "null"], "minimum": 1},
        "touch": {"description": "true for a node a reached node only points at, by a kind listed under cause touch; given with --touch and never walked from.", "type": "boolean"}
      }
    },
    "cause_walk": {
      "description": "neighbors (direction off: what the starts set off) or affected (direction by: what sets them off), walked by the map's cause lists to the end; rows holds every row within --depth, with no text budget.",
      "type": "object", "additionalProperties": false,
      "required": ["command", "direction", "starts", "rows", "hops", "total", "last_hop", "shown_hops", "hubs", "undeclared", "again", "warnings", "problems"],
      "properties": {
        "command": {"enum": ["neighbors", "affected"]},
        "direction": {"enum": ["off", "by"]},
        "starts": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/cause_row"}},
        "hops": {
          "description": "Every hop of the walk to its end, also past --depth: how many things it reached, by type.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["hop", "things", "by_type"],
            "properties": {
              "hop": {"type": "integer", "minimum": 1},
              "things": {"type": "integer", "minimum": 0},
              "by_type": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "total": {"description": "Every thing the walk reached to its end.", "type": "integer", "minimum": 0},
        "last_hop": {"type": "integer", "minimum": 0},
        "shown_hops": {"description": "The hops rows holds: --depth, or last_hop when that is less.", "type": "integer", "minimum": 0},
        "hubs": {"type": "array", "items": {"$ref": "#/$defs/hub"}},
        "undeclared": {"description": "The kinds under no cause list that reached a row; walked by raw direction.", "type": "array", "items": {"type": "string"}},
        "again": {"description": "The command that prints the whole walk.", "type": "string"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "depth_direction": {
      "type": "object", "additionalProperties": false, "required": ["hops", "things", "per_hop", "hubs"],
      "properties": {
        "hops": {"description": "Hops until the walk reaches nothing new.", "type": "integer", "minimum": 0},
        "things": {"type": "integer", "minimum": 0},
        "per_hop": {"description": "How many things each hop reached, from hop 1.", "type": "array", "items": {"type": "integer", "minimum": 0}},
        "hubs": {"type": "array", "items": {"$ref": "#/$defs/hub"}}
      }
    },
    "touching_count": {
      "type": "object", "additionalProperties": false, "required": ["things", "kinds"],
      "properties": {
        "things": {"type": "integer", "minimum": 0},
        "kinds": {"description": "Edges by touch kind.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "depth": {
      "description": "periplus depth: both walks by cause from the starts, to the end.",
      "type": "object", "additionalProperties": false,
      "required": ["starts", "sets_off", "set_off_by", "touching", "undeclared", "declares_causes", "warnings", "problems"],
      "properties": {
        "starts": {"type": "array", "items": {"type": "string"}},
        "sets_off": {"$ref": "#/$defs/depth_direction"},
        "set_off_by": {"$ref": "#/$defs/depth_direction"},
        "touching": {
          "type": "object", "additionalProperties": false, "required": ["point_at_starts", "starts_point_at"],
          "properties": {
            "point_at_starts": {"$ref": "#/$defs/touching_count"},
            "starts_point_at": {"$ref": "#/$defs/touching_count"}
          }
        },
        "undeclared": {"type": "array", "items": {"type": "string"}},
        "declares_causes": {"description": "false for a map with no cause list, where every kind was walked by raw direction.", "type": "boolean"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "path": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "chains", "warnings", "problems"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "chains": {
          "allOf": [{"$ref": "#/$defs/listing"}],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["from", "kind", "to", "from_marks", "to_marks", "location", "source", "description"],
                  "properties": {
                    "from": {"type": "string"},
                    "kind": {"type": "string"},
                    "to": {"type": "string"},
                    "from_marks": {"$ref": "#/$defs/marks", "description": "The marks of the step's from node."},
                    "to_marks": {"$ref": "#/$defs/marks", "description": "The marks of the step's to node."},
                    "location": {"$ref": "#/$defs/place"},
                    "source": {"$ref": "#/$defs/source"},
                    "description": {"$ref": "#/$defs/node_text", "description": "The descriptions.yaml text of the step's to node, or null."}
                  }
                }
              }
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "slice": {
      "type": "object", "additionalProperties": false, "required": ["out", "nodes", "edges", "warnings", "problems"],
      "properties": {
        "out": {"type": ["string", "null"]},
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "slice_piece": {
      "description": "What slice prints without --out: the start nodes, the pieces they fall into, then the rows reached from them breadth-first.",
      "type": "object", "additionalProperties": false,
      "required": ["starts", "pieces", "rows", "left_out", "deeper", "folded", "notes", "members", "depth", "direction", "warnings", "problems"],
      "properties": {
        "starts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "state", "location", "source", "matched", "matched_attribute", "description", "supporting", "marks", "given", "words", "piece"],
            "properties": {
              "id": {"type": "string"},
              "piece": {"$ref": "#/$defs/piece_number"},
              "type": {"type": "string"},
              "state": {"type": "string"},
              "location": {"type": ["string", "null"]},
              "source": {"$ref": "#/$defs/source"},
              "matched": {"description": "Where the best word matched, as find reports it; id for a given start.", "enum": ["id", "attribute", "description"]},
              "supporting": {"description": "true when the node is in supporting code, by the map's supporting_paths.", "type": "boolean"},
              "marks": {"$ref": "#/$defs/marks"},
              "matched_attribute": {"type": ["string", "null"]},
              "description": {"$ref": "#/$defs/node_text"},
              "given": {"description": "The argument that named this node, or null when words found it.", "type": ["string", "null"]},
              "words": {
                "description": "Each word that found this node, and where it matched.",
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["word", "matched", "matched_attribute"],
                  "properties": {
                    "word": {"type": "string"},
                    "matched": {"enum": ["id", "attribute", "description"]},
                    "matched_attribute": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        },
        "pieces": {
          "description": "The pieces, in printed order: sets of reached nodes that edges other than grouping edges join. The map holds no edge between two of them.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["piece", "starts", "things", "supporting"],
            "properties": {
              "piece": {"$ref": "#/$defs/piece_number"},
              "starts": {"description": "The start ids in the piece, in pick order.", "type": "array", "items": {"type": "string"}},
              "things": {"description": "How many nodes the printed piece names in it.", "type": "integer", "minimum": 0},
              "supporting": {"description": "How many nodes in supporting code the walk from its starts left out; 0 with --support.", "type": "integer", "minimum": 0}
            }
          }
        },
        "rows": {
          "allOf": [{"$ref": "#/$defs/listing"}],
          "properties": {
            "items": {
              "type": "array",
              "items": {"$ref": "#/$defs/slice_row"}
            }
          }
        },
        "left_out": {
          "description": "The rows --limit cut, counted by hop and by edge kind.",
          "type": "object", "additionalProperties": false, "required": ["by_hop", "by_kind"],
          "properties": {
            "by_hop": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "by_kind": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
          }
        },
        "deeper": {"description": "true when an edge leads on past the last hop.", "type": "boolean"},
        "folded": {"description": "Nodes left out of the rows because all their edges, two or more, join them to the node above, counted by type.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "members": {
          "description": "For each start that is a container: its members by grouping edges, counted by type, rarest type first, and the rows shown.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["container", "total", "by_type", "rows"],
            "properties": {
              "container": {"type": "string"},
              "total": {"type": "integer", "minimum": 0},
              "by_type": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "rows": {"type": "array", "items": {"$ref": "#/$defs/slice_row"}}
            }
          }
        },
        "notes": {"description": "How the words were read, such as a text that matched nothing as a whole.", "type": "array", "items": {"type": "string"}},
        "depth": {"type": "integer", "minimum": 1},
        "direction": {"enum": ["out", "in", "both"]},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "piece_number": {"description": "The number of the piece the node is in, from 1, as printed.", "type": "integer", "minimum": 1},

    "slice_row": {
      "description": "One walk row of a slice piece, and one member row of a container start.",
      "type": "object", "additionalProperties": false,
      "required": ["start", "hop", "from", "kind", "direction", "id", "type", "state", "marks", "again", "location", "source", "description", "container", "piece"],
      "properties": {
        "piece": {"$ref": "#/$defs/piece_number"},
        "start": {"description": "The start node this row hangs under.", "type": "string"},
        "hop": {"description": "Hops from the start; 0 for a node that stands for the start.", "type": "integer", "minimum": 0},
        "from": {"description": "The node the row was reached from.", "type": "string"},
        "kind": {"type": "string"},
        "direction": {"description": "out when the edge runs from the from node to id, in when it runs from id to the from node.", "enum": ["out", "in"]},
        "id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "marks": {"$ref": "#/$defs/marks"},
        "again": {"description": "true when id is printed in full on another row of this piece.", "type": "boolean"},
        "container": {"description": "true when id is the container end of a grouping edge; the walk does not go on from it.", "type": "boolean"},
        "location": {"$ref": "#/$defs/place"},
        "source": {"$ref": "#/$defs/source"},
        "description": {"$ref": "#/$defs/node_text"}
      }
    },

    "show_many": {
      "description": "periplus show with several ids: one show document each, in the order given.",
      "type": "object", "additionalProperties": false, "required": ["shown"],
      "properties": {"shown": {"type": "array", "items": {"$ref": "#/$defs/show"}}}
    },

    "set_thing": {
      "description": "A thing of a set: its full id, type, state and own first file:line, or null.",
      "type": "object", "additionalProperties": false, "required": ["id", "type", "state", "location", "marks", "supporting"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "location": {"$ref": "#/$defs/place"},
        "marks": {"$ref": "#/$defs/marks"},
        "supporting": {"type": "boolean"}
      }
    },

    "only": {
      "description": "periplus only: the things the starts set off whose every setting-off chain passes through a start.",
      "type": "object", "additionalProperties": false,
      "required": ["command", "starts", "reached", "only", "warnings", "problems"],
      "properties": {
        "command": {"const": "only"},
        "starts": {"type": "array", "items": {"type": "string"}},
        "reached": {"description": "How many things the walk by cause from the starts set off.", "type": "integer", "minimum": 0},
        "only": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "state", "hop", "location", "marks", "supporting"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "state": {"type": "string"},
              "hop": {"type": "integer", "minimum": 1},
              "location": {"$ref": "#/$defs/place"},
              "marks": {"$ref": "#/$defs/marks"},
              "supporting": {"type": "boolean"}
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "hubs": {
      "description": "periplus hubs: the hubs the walk by cause from the starts stopped at.",
      "type": "object", "additionalProperties": false,
      "required": ["command", "direction", "starts", "depth", "hub", "hubs", "warnings", "problems"],
      "properties": {
        "command": {"const": "hubs"},
        "direction": {"enum": ["off", "by"]},
        "starts": {"type": "array", "items": {"type": "string"}},
        "depth": {"description": "The hops looked within; null for all.", "type": ["integer", "null"], "minimum": 1},
        "hub": {"description": "The hub limit: a hub has more edges to follow than this.", "type": "integer", "minimum": 0},
        "hubs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "hop", "fan", "marks", "supporting"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "hop": {"type": "integer", "minimum": 1},
              "fan": {"type": "integer", "minimum": 1},
              "marks": {"$ref": "#/$defs/marks"},
              "supporting": {"type": "boolean"}
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "members": {
      "description": "periplus members: what each container holds by the map's grouping kinds.",
      "type": "object", "additionalProperties": false, "required": ["command", "containers", "warnings", "problems"],
      "properties": {
        "command": {"const": "members"},
        "containers": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["container", "total", "by_type", "members"],
            "properties": {
              "container": {"type": "string"},
              "total": {"type": "integer", "minimum": 0},
              "by_type": {"type": "object", "additionalProperties": {"type": "integer"}},
              "members": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "type", "state", "location", "kind", "marks", "supporting"],
                  "properties": {
                    "id": {"type": "string"},
                    "type": {"type": "string"},
                    "state": {"type": "string"},
                    "location": {"$ref": "#/$defs/place"},
                    "kind": {"description": "The grouping kind that joins the member to the container.", "type": "string"},
                    "marks": {"$ref": "#/$defs/marks"},
                    "supporting": {"type": "boolean"}
                  }
                }
              }
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "pieces": {
      "description": "periplus pieces: the given things split into the groups edges among them join, largest first.",
      "type": "object", "additionalProperties": false, "required": ["command", "pieces", "warnings", "problems"],
      "properties": {
        "command": {"const": "pieces"},
        "pieces": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/set_thing"}}},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "count": {
      "description": "periplus count: how many things the ids name, by type and state, the edges among them by kind, and the ids that name no node.",
      "type": "object", "additionalProperties": false,
      "required": ["command", "given", "things", "repeated", "short_names", "by_type", "by_state", "edges", "not_found", "problems"],
      "properties": {
        "command": {"const": "count"},
        "given": {"type": "integer", "minimum": 0},
        "things": {"type": "integer", "minimum": 0},
        "repeated": {"description": "Ids given that name a thing an earlier id named.", "type": "integer", "minimum": 0},
        "short_names": {"description": "Ids given as a short name.", "type": "integer", "minimum": 0},
        "by_type": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_state": {"type": "object", "additionalProperties": {"type": "integer"}},
        "edges": {"description": "The edges both of whose ends are among the things, by kind.", "type": "object", "additionalProperties": {"type": "integer"}},
        "not_found": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "fits"],
            "properties": {
              "id": {"type": "string"},
              "fits": {"description": "How many nodes a short name fits: 0 for none, 2 or more for several.", "type": "integer", "minimum": 0}
            }
          }
        },
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "in": {
      "description": "periplus in: the things the map locates in each file asked, by line; a thing's location is its smallest line in that file.",
      "type": "object", "additionalProperties": false, "required": ["command", "files", "warnings", "problems"],
      "properties": {
        "command": {"const": "in"},
        "files": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["file", "things"],
            "properties": {
              "file": {"type": "string"},
              "things": {"description": "Empty when the map locates nothing in the file.", "type": "array", "items": {"$ref": "#/$defs/set_thing"}}
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "at": {
      "description": "periplus at: for each file and line asked, the mapped things on that line or the nearest line above it that holds one, innermost first, then what holds them, outward.",
      "type": "object", "additionalProperties": false, "required": ["command", "places", "problems"],
      "properties": {
        "command": {"const": "at"},
        "places": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["file", "line", "found_line", "things", "containers"],
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "found_line": {"description": "The line the things are on, or null when no mapped thing is at or above the line.", "type": ["integer", "null"]},
              "things": {"type": "array", "items": {"$ref": "#/$defs/set_thing"}},
              "containers": {"description": "What holds the things: the node each id nests inside, else the container of its grouping edge, outward.", "type": "array", "items": {"$ref": "#/$defs/set_thing"}}
            }
          }
        },
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "files": {
      "description": "periplus files: the files that hold the things the ids name, each with how many, most first.",
      "type": "object", "additionalProperties": false, "required": ["command", "things", "files", "no_location", "warnings", "problems"],
      "properties": {
        "command": {"const": "files"},
        "things": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["file", "count"],
            "properties": {"file": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}
          }
        },
        "no_location": {"description": "Things with no location.", "type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "undescribed": {
      "description": "periplus undescribed: the main things of the map, or of the ids, that the descriptions file does not describe. A main thing is mapped, has a location, is not in supporting code, and is not of a part type: a type more than half of whose mapped, located things nest inside another thing by their id and hold none.",
      "type": "object", "additionalProperties": false,
      "required": ["command", "by", "main", "described", "counts", "undescribed", "left_out", "warnings", "problems"],
      "properties": {
        "command": {"const": "undescribed"},
        "by": {"enum": ["file", "type", "container"]},
        "main": {"type": "integer", "minimum": 0},
        "described": {"type": "integer", "minimum": 0},
        "counts": {
          "description": "The undescribed things counted by file, type or container, most first. A key of null is no container.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "count"],
            "properties": {"key": {"type": ["string", "null"]}, "count": {"type": "integer", "minimum": 1}}
          }
        },
        "undescribed": {"description": "The undescribed main things' ids, by file, line, then id.", "type": "array", "items": {"type": "string"}},
        "left_out": {
          "type": "object", "additionalProperties": false, "required": ["parts", "supporting", "unplaced"],
          "properties": {
            "parts": {"description": "The things of part types, by type.", "type": "object", "additionalProperties": {"type": "integer"}},
            "supporting": {"description": "Things in supporting code.", "type": "integer", "minimum": 0},
            "unplaced": {"description": "Things not mapped, or with no location.", "type": "integer", "minimum": 0}
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "stamp": {
      "description": "periplus stamp: the node entries of the descriptions file given a fingerprint of the code they describe, those that kept the one they had, and those skipped.",
      "type": "object", "additionalProperties": false, "required": ["command", "found", "stamped", "kept", "skipped", "problems"],
      "properties": {
        "command": {"const": "stamp"},
        "found": {"description": "False when there is no descriptions file.", "type": "boolean"},
        "stamped": {"type": "integer", "minimum": 0},
        "kept": {"description": "Entries that had a fingerprint, left as they were without --all.", "type": "integer", "minimum": 0},
        "skipped": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "reason"],
            "properties": {"id": {"type": "string"}, "reason": {"type": "string"}}
          }
        },
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "stale": {
      "description": "periplus stale: the node entries of the descriptions file whose fingerprint no longer matches their code, whose node the map no longer holds, or whose code cannot be read.",
      "type": "object", "additionalProperties": false,
      "required": ["command", "found", "entries", "fresh", "changed", "gone", "unreadable", "unstamped", "problems"],
      "properties": {
        "command": {"const": "stale"},
        "found": {"description": "False when there is no descriptions file.", "type": "boolean"},
        "entries": {"type": "integer", "minimum": 0},
        "fresh": {"type": "integer", "minimum": 0},
        "changed": {"type": "array", "items": {"$ref": "#/$defs/set_thing"}},
        "gone": {"description": "Entry ids no node of the map has.", "type": "array", "items": {"type": "string"}},
        "unreadable": {"type": "array", "items": {"$ref": "#/$defs/set_thing"}},
        "unstamped": {"description": "Entries with no fingerprint.", "type": "integer", "minimum": 0},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "order": {
      "description": "periplus order: the given things, each after the things of the set it calls or uses by the cause of each edge kind; things that use each other through a chain are a loop and come together.",
      "type": "object", "additionalProperties": false, "required": ["command", "things", "warnings", "problems"],
      "properties": {
        "command": {"const": "order"},
        "things": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "state", "location", "marks", "supporting", "loop"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "state": {"type": "string"},
              "location": {"$ref": "#/$defs/place"},
              "marks": {"$ref": "#/$defs/marks"},
              "supporting": {"type": "boolean"},
              "loop": {"description": "The number of the loop the thing is in, counted in printed order, or null.", "type": ["integer", "null"]}
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "export": {
      "type": "object", "additionalProperties": false, "required": ["format", "warnings", "problems"],
      "properties": {
        "format": {"type": "string"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    }
  }
}
