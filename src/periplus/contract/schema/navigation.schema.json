{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://periplus.dev/schema/0/navigation.schema.json",
  "title": "Periplus navigation result",
  "description": "What `--format json` prints for the navigation commands: types, legend, find, show, neighbors, affected, path and slice, and what `export --report json` prints to standard error. Each command has one definition under $defs, slice two (slice with --out, slice_piece without), and the root accepts any of them. A command that returns a list wraps it in the shared listing: items, total (every item there was), shown (how many items are here) and truncated (true when --limit cut the list). Output is deterministic: keys sorted, ASCII only.",

  "anyOf": [
    {"$ref": "#/$defs/types"},
    {"$ref": "#/$defs/legend"},
    {"$ref": "#/$defs/find"},
    {"$ref": "#/$defs/show"},
    {"$ref": "#/$defs/neighbors"},
    {"$ref": "#/$defs/affected"},
    {"$ref": "#/$defs/path"},
    {"$ref": "#/$defs/slice"},
    {"$ref": "#/$defs/slice_piece"},
    {"$ref": "#/$defs/export"}
  ],

  "$defs": {

    "problem": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "detail"],
      "properties": {
        "code": {"type": "integer"},
        "message": {"type": "string"},
        "detail": {"type": "object"}
      }
    },
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "place": {"description": "Where a row's edge is written as file:line, else the node it reaches, or null when neither has a location.", "type": ["string", "null"]},
    "source": {"description": "The stripped source line at the row's place, at most 160 characters, or null when the file or line cannot be read.", "type": ["string", "null"]},
    "node_text": {"description": "The descriptions.yaml text of the row's node, or null when it has none.", "type": ["string", "null"]},

    "location": {
      "type": "object", "required": ["file", "line"],
      "properties": {"file": {"type": "string"}, "line": {"type": "integer"}}
    },
    "provenance": {
      "type": "object", "required": ["pack", "rule"],
      "properties": {
        "pack": {"type": "string"},
        "rule": {"type": "string"},
        "confidence": {"enum": ["declared", "inferred"]},
        "sets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "description": {
      "description": "The descriptions.yaml entry for a node or edge, or null when it has none.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["text", "file", "line"],
          "properties": {"text": {"type": "string"}, "file": {"type": "string"}, "line": {"type": "integer"}}
        },
        {"type": "null"}
      ]
    },

    "listing": {
      "description": "The shared cut list. The items schema is supplied by the command that uses it.",
      "type": "object", "additionalProperties": false, "required": ["items", "total", "shown", "truncated"],
      "properties": {
        "items": {"type": "array"},
        "total": {"type": "integer", "minimum": 0},
        "shown": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },

    "types": {
      "type": "object", "additionalProperties": false, "required": ["node_types", "edge_kinds", "problems"],
      "properties": {
        "node_types": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "count", "parent"],
            "properties": {
              "type": {"type": "string"},
              "count": {"type": "integer", "minimum": 0},
              "parent": {"type": ["string", "null"]}
            }
          }
        },
        "edge_kinds": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "count"],
            "properties": {"kind": {"type": "string"}, "count": {"type": "integer", "minimum": 0}}
          }
        },
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "legend": {
      "description": "The edge kinds and node types the map holds, most frequent first, each with the pack's one-line description from the map's legend, or null.",
      "type": "object", "additionalProperties": false, "required": ["edge_kinds", "node_types", "left_out", "warnings", "problems"],
      "properties": {
        "edge_kinds": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "count", "from", "to", "description"],
            "properties": {
              "kind": {"type": "string"},
              "count": {"type": "integer", "minimum": 1},
              "from": {"description": "The types at the edges' from ends, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "to": {"description": "The types at the edges' to ends, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "description": {"type": ["string", "null"]}
            }
          }
        },
        "node_types": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "count", "parent", "description", "out", "in"],
            "properties": {
              "type": {"type": "string"},
              "count": {"type": "integer", "minimum": 1},
              "parent": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "out": {"description": "The kinds of the edges leaving nodes of this type, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "in": {"description": "The kinds of the edges reaching nodes of this type, with how many edges each.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "left_out": {"description": "How many rows the default text's byte budget left out, the least frequent first; 0 with --all, --kind or --type.", "type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "find": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "total", "shown", "truncated", "by_type", "warnings", "problems"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "state", "location", "source", "matched", "matched_attribute", "description"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "state": {"type": "string"},
              "location": {"type": ["string", "null"]},
              "source": {"$ref": "#/$defs/source"},
              "matched": {"description": "id when the node id holds the text, attribute when a string attribute value or list item does, description when only its description does.", "enum": ["id", "attribute", "description"]},
              "matched_attribute": {"description": "The name of the attribute that matched, the first in sorted order when several do; null unless matched is attribute.", "type": ["string", "null"]},
              "description": {"$ref": "#/$defs/node_text"}
            }
          }
        },
        "by_type": {
          "description": "Every match, not only the rows shown, counted by node type.",
          "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "total": {"type": "integer", "minimum": 0},
        "shown": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "edge_row": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "other", "other_type", "other_state", "locations", "occurrences", "confidences", "rules", "description", "location", "source"],
      "properties": {
        "kind": {"type": "string"},
        "other": {"type": "string"},
        "other_type": {"type": "string"},
        "other_state": {"type": "string"},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "occurrences": {"type": ["integer", "null"]},
        "confidences": {"type": "array", "items": {"enum": ["declared", "inferred"]}},
        "rules": {"type": "array", "items": {"type": "string"}},
        "description": {"$ref": "#/$defs/description"},
        "location": {"$ref": "#/$defs/place"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "edge_listing": {
      "allOf": [{"$ref": "#/$defs/listing"}],
      "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/edge_row"}}}
    },

    "show": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "state", "roles", "attributes", "locations", "provenance", "description", "outgoing", "incoming", "warnings", "problems"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "roles": {"type": "array", "items": {"type": "string"}},
        "attributes": {"type": "object"},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
        "description": {"$ref": "#/$defs/description"},
        "outgoing": {"$ref": "#/$defs/edge_listing"},
        "incoming": {"$ref": "#/$defs/edge_listing"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "walk": {
      "type": "object", "additionalProperties": false, "required": ["start", "direction", "rows", "warnings", "problems"],
      "properties": {
        "start": {"type": "string"},
        "direction": {"enum": ["out", "in"]},
        "rows": {
          "allOf": [{"$ref": "#/$defs/listing"}],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "type", "state", "depth", "kind", "via", "location", "source", "description"],
                "properties": {
                  "id": {"type": "string"},
                  "type": {"type": "string"},
                  "state": {"type": "string"},
                  "depth": {"type": "integer", "minimum": 1},
                  "kind": {"type": "string"},
                  "via": {"type": "string"},
                  "location": {"$ref": "#/$defs/place"},
                  "source": {"$ref": "#/$defs/source"},
                  "description": {"$ref": "#/$defs/node_text"}
                }
              }
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },
    "neighbors": {"allOf": [{"$ref": "#/$defs/walk"}], "properties": {"direction": {"const": "out"}}},
    "affected": {"allOf": [{"$ref": "#/$defs/walk"}], "properties": {"direction": {"const": "in"}}},

    "path": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "chains", "warnings", "problems"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "chains": {
          "allOf": [{"$ref": "#/$defs/listing"}],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["from", "kind", "to", "location", "source", "description"],
                  "properties": {
                    "from": {"type": "string"},
                    "kind": {"type": "string"},
                    "to": {"type": "string"},
                    "location": {"$ref": "#/$defs/place"},
                    "source": {"$ref": "#/$defs/source"},
                    "description": {"$ref": "#/$defs/node_text", "description": "The descriptions.yaml text of the step's to node, or null."}
                  }
                }
              }
            }
          }
        },
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "slice": {
      "type": "object", "additionalProperties": false, "required": ["out", "nodes", "edges", "warnings", "problems"],
      "properties": {
        "out": {"type": ["string", "null"]},
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "slice_piece": {
      "description": "What slice prints without --out: the start nodes, then the rows reached from them breadth-first.",
      "type": "object", "additionalProperties": false,
      "required": ["starts", "rows", "left_out", "deeper", "folded", "notes", "members", "depth", "direction", "warnings", "problems"],
      "properties": {
        "starts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "state", "location", "source", "matched", "matched_attribute", "description", "given", "words"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "state": {"type": "string"},
              "location": {"type": ["string", "null"]},
              "source": {"$ref": "#/$defs/source"},
              "matched": {"description": "Where the best word matched, as find reports it; id for a given start.", "enum": ["id", "attribute", "description"]},
              "matched_attribute": {"type": ["string", "null"]},
              "description": {"$ref": "#/$defs/node_text"},
              "given": {"description": "The argument that named this node, or null when words found it.", "type": ["string", "null"]},
              "words": {
                "description": "Each word that found this node, and where it matched.",
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["word", "matched", "matched_attribute"],
                  "properties": {
                    "word": {"type": "string"},
                    "matched": {"enum": ["id", "attribute", "description"]},
                    "matched_attribute": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        },
        "rows": {
          "allOf": [{"$ref": "#/$defs/listing"}],
          "properties": {
            "items": {
              "type": "array",
              "items": {"$ref": "#/$defs/slice_row"}
            }
          }
        },
        "left_out": {
          "description": "The rows --limit cut, counted by hop and by edge kind.",
          "type": "object", "additionalProperties": false, "required": ["by_hop", "by_kind"],
          "properties": {
            "by_hop": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
            "by_kind": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
          }
        },
        "deeper": {"description": "true when an edge leads on past the last hop.", "type": "boolean"},
        "folded": {"description": "Nodes left out of the rows because all their edges, two or more, join them to the node above, counted by type.", "type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "members": {
          "description": "For each start that is a container: its members by grouping edges, counted by type, rarest type first, and the rows shown.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["container", "total", "by_type", "rows"],
            "properties": {
              "container": {"type": "string"},
              "total": {"type": "integer", "minimum": 0},
              "by_type": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
              "rows": {"type": "array", "items": {"$ref": "#/$defs/slice_row"}}
            }
          }
        },
        "notes": {"description": "How the words were read, such as a text that matched nothing as a whole.", "type": "array", "items": {"type": "string"}},
        "depth": {"type": "integer", "minimum": 1},
        "direction": {"enum": ["out", "in", "both"]},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    },

    "slice_row": {
      "description": "One walk row of a slice piece, and one member row of a container start.",
      "type": "object", "additionalProperties": false,
      "required": ["start", "hop", "from", "kind", "direction", "id", "type", "state", "again", "location", "source", "description", "container"],
      "properties": {
        "start": {"description": "The start node this row hangs under.", "type": "string"},
        "hop": {"type": "integer", "minimum": 1},
        "from": {"description": "The node the row was reached from.", "type": "string"},
        "kind": {"type": "string"},
        "direction": {"description": "out when the edge runs from the from node to id, in when it runs from id to the from node.", "enum": ["out", "in"]},
        "id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "again": {"description": "true when id is printed in full on another row of this piece.", "type": "boolean"},
        "container": {"description": "true when id is the container end of a grouping edge; the walk does not go on from it.", "type": "boolean"},
        "location": {"$ref": "#/$defs/place"},
        "source": {"$ref": "#/$defs/source"},
        "description": {"$ref": "#/$defs/node_text"}
      }
    },

    "export": {
      "type": "object", "additionalProperties": false, "required": ["format", "warnings", "problems"],
      "properties": {
        "format": {"type": "string"},
        "warnings": {"$ref": "#/$defs/warnings"},
        "problems": {"$ref": "#/$defs/problems"}
      }
    }
  }
}
